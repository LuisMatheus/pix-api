{
  "name": "pix-api-contract",
  "version": "2.11.0-rc1",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "bundle": "redocly bundle spec/openapi.yaml --output openapi.yaml",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:request": "node --test tests/request.test.mjs",
    "lint": "mkdir -p reports && redocly lint openapi.yaml --format json --max-problems 10000 > reports/lint.json",
    "lint:full": "redocly lint openapi.yaml --max-problems 10000",
    "build:docs": "node scripts/build-docs.mjs",
    "preview:docs": "node scripts/preview-docs.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.82.0"
  }
}
